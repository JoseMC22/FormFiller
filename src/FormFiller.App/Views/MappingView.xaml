<UserControl x:Class="FormFiller.App.Views.MappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Plantillas guardadas" Grid.Column="0" Margin="0,0,4,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Actualizar plantillas" Command="{Binding LoadTemplatesCommand}"
                                Style="{StaticResource OutlineButton}" Padding="10,4" />
                        <Button Content="Cargar mapeos" Command="{Binding LoadMappingsCommand}"
                                Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Padding="10,4" />
                    </StackPanel>
                    <ListView ItemsSource="{Binding Templates}"
                              SelectedItem="{Binding SelectedTemplate}"
                              Height="110">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding WindowTitle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </GroupBox>

            <GroupBox Header="Datos de Excel" Grid.Column="1" Margin="4,0,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Abrir Excel..."
                                Command="{Binding OpenExcelCommand}" Style="{StaticResource OutlineButton}"
                                Padding="10,4" Margin="6,0,0,0" />
                        <TextBox Text="{Binding ExcelFilePath}" IsReadOnly="True"
                                 VerticalContentAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Hoja:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding Sheets}"
                                  SelectedItem="{Binding SelectedSheet}" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Columnas:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ListBox ItemsSource="{Binding Columns}" Height="70" />
                    </DockPanel>
                </StackPanel>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="1" Header="Mapeo de campos a columnas" Margin="0,8,0,0">
            <DataGrid ItemsSource="{Binding MappingRows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Campo" Width="*"
                                        Binding="{Binding FieldName}"
                                        IsReadOnly="True" />
                    <DataGridTemplateColumn Header="Tipo de campo" Width="0.7*" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FieldType, Converter={StaticResource EnumToSpanishConverter}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Columna de Excel" Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SelectedColumn}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          SelectedItem="{Binding SelectedColumn, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Button DockPanel.Dock="Left" Content="Guardar mapeos"
                    Command="{Binding SaveMappingsCommand}" Style="{StaticResource PrimaryButton}" Padding="12,6" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"
                       Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</UserControl>
