<UserControl x:Class="FormFiller.App.Views.RecipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:FormFiller.Core.Models;assembly=FormFiller.Core"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Plantillas" Grid.Column="0" Margin="0,0,4,0">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="Actualizar plantillas"
                            Command="{Binding LoadTemplatesCommand}" Style="{StaticResource OutlineButton}"
                            Padding="10,4" Margin="0,0,0,6" />
                    <ListView ItemsSource="{Binding Templates}"
                              SelectedItem="{Binding SelectedTemplate}"
                              Height="100">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding WindowTitle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </GroupBox>

            <GroupBox Header="Recetas" Grid.Column="1" Margin="4,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Nueva receta" Command="{Binding NewRecipeCommand}"
                                Style="{StaticResource OutlineButton}" Padding="10,4" />
                        <Button Content="Eliminar receta" Command="{Binding DeleteRecipeCommand}"
                                Style="{StaticResource DangerButton}" Padding="10,4" Margin="8,0,0,0" />
                    </StackPanel>
                    <ListView ItemsSource="{Binding Recipes}"
                              SelectedItem="{Binding SelectedRecipe}"
                              Height="70">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Nombre:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="1"
                     Text="{Binding SelectedRecipe.Name, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" />
            <Button Grid.Column="2" Content="Guardar receta" Command="{Binding SaveRecipeCommand}"
                    Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="8,0,0,0" />
        </Grid>

        <GroupBox Grid.Row="2" Header="Pasos" Margin="0,8,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Agregar asignación" Command="{Binding AddStepCommand}"
                            CommandParameter="{x:Static models:RecipeStepType.SetField}" Style="{StaticResource OutlineButton}" Padding="10,4" />
                    <Button Content="Agregar clic" Command="{Binding AddStepCommand}"
                            CommandParameter="{x:Static models:RecipeStepType.ClickButton}" Style="{StaticResource OutlineButton}" Padding="10,4" Margin="6,0,0,0" />
                    <Button Content="Agregar espera" Command="{Binding AddStepCommand}"
                            CommandParameter="{x:Static models:RecipeStepType.Wait}" Style="{StaticResource OutlineButton}" Padding="10,4" Margin="6,0,0,0" />
                    <Button Content="Agregar espera de ventana" Command="{Binding AddStepCommand}"
                            CommandParameter="{x:Static models:RecipeStepType.WaitForWindow}" Style="{StaticResource OutlineButton}" Padding="10,4" Margin="6,0,0,0" />
                    <Button Content="Agregar clic si visible" Command="{Binding AddStepCommand}"
                            CommandParameter="{x:Static models:RecipeStepType.ClickIfWindowVisible}" Style="{StaticResource OutlineButton}" Padding="10,4" Margin="6,0,0,0" />
                    <Button Content="Quitar" Command="{Binding RemoveStepCommand}"
                            Style="{StaticResource DangerButton}" Padding="10,4" Margin="6,0,0,0" />
                    <Button Content="Subir" Command="{Binding MoveUpStepCommand}"
                            Style="{StaticResource OutlineButton}" Padding="10,4" Margin="6,0,0,0" />
                    <Button Content="Bajar" Command="{Binding MoveDownStepCommand}"
                            Style="{StaticResource OutlineButton}" Padding="10,4" Margin="6,0,0,0" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Steps}"
                          SelectedItem="{Binding SelectedStep}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Tipo de paso" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StepType, Converter={StaticResource EnumToSpanishConverter}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.StepTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding StepType, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumToSpanishConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Destino" Width="*"
                                            Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="Valor" Width="*"
                                            Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Margin="0,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"
                       Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</UserControl>
