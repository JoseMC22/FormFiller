<UserControl x:Class="FormFiller.App.Views.RunnerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Templates" Grid.Column="0" Margin="0,0,4,0">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="Refresh templates"
                            Command="{Binding LoadTemplatesCommand}" Padding="10,4" Margin="0,0,0,6" />
                    <ListView ItemsSource="{Binding Templates}"
                              SelectedItem="{Binding SelectedTemplate}"
                              Height="110">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock FontSize="11" Foreground="Gray"
                                               Text="{Binding WindowTitle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </GroupBox>

            <GroupBox Header="Target Window" Grid.Column="1" Margin="4,0,4,0">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="Refresh windows"
                            Command="{Binding RefreshWindowsCommand}" Padding="10,4" Margin="0,0,0,6" />
                    <ListView ItemsSource="{Binding Windows}"
                              SelectedItem="{Binding SelectedWindow}"
                              Height="110">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding ProcessName}" />
                                    <TextBlock FontSize="11" Foreground="Gray"
                                               Text="{Binding WindowTitle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </GroupBox>

            <GroupBox Header="Excel Data" Grid.Column="2" Margin="4,0,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Open Excel..."
                                Command="{Binding OpenExcelCommand}" Padding="10,4" Margin="6,0,0,0" />
                        <TextBox Text="{Binding ExcelFilePath}" IsReadOnly="True"
                                 VerticalContentAlignment="Center" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Sheet:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding Sheets}"
                                  SelectedItem="{Binding SelectedSheet}" />
                    </DockPanel>
                </StackPanel>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Recipe (optional):" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Recipes}"
                      SelectedItem="{Binding SelectedRecipe}"
                      DisplayMemberPath="Name" Margin="0,0,8,0" />

            <TextBlock Grid.Column="2" Text="Submit button:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Grid.Column="3" ItemsSource="{Binding SubmitButtons}"
                      SelectedItem="{Binding SelectedSubmitButton}" Margin="0,0,8,0" />

            <TextBlock Grid.Column="4" Text="Start row:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="5" VerticalContentAlignment="Center"
                     Text="{Binding StartRow, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Column="6" Text="End row:" VerticalAlignment="Center" Margin="8,0,6,0" />
            <TextBox Grid.Column="7" VerticalContentAlignment="Center"
                     Text="{Binding EndRow, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Column="8" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="Run" Command="{Binding RunCommand}" Padding="14,5" FontWeight="Bold" />
                <Button Content="Stop" Command="{Binding StopCommand}" Padding="14,5" Margin="6,0,0,0" />
            </StackPanel>

            <TextBlock Grid.Column="10" Text="Row:" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Margin="12,0,4,0" />
            <TextBlock Grid.Column="11" Text="{Binding CurrentRow}" VerticalAlignment="Center" />
        </Grid>

        <ProgressBar Grid.Row="2" Height="18" Margin="0,8,0,0"
                     Minimum="0" Maximum="{Binding ProgressTotal}"
                     Value="{Binding ProgressCurrent}" />

        <GroupBox Grid.Row="3" Header="Results" Margin="0,8,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" Foreground="DimGray"
                           Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                <DataGrid ItemsSource="{Binding Results}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Row" Width="60"
                                            Binding="{Binding RowNumber}" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="OK" Width="60" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="" />
                                                <Setter Property="Foreground" Value="Gray" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Success}" Value="True">
                                                        <Setter Property="Text" Value="&#x2713;" />
                                                        <Setter Property="Foreground" Value="Green" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Success}" Value="False">
                                                        <Setter Property="Text" Value="&#x2717;" />
                                                        <Setter Property="Foreground" Value="Red" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Message" Width="*"
                                            Binding="{Binding Message}" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>
    </Grid>
</UserControl>
