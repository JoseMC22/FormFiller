<UserControl x:Class="FormFiller.App.Views.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1.4*" />
        </Grid.ColumnDefinitions>

        <GroupBox Header="Windows" Grid.Column="0" Margin="0,0,4,0">
            <DockPanel>
                <Button DockPanel.Dock="Top" Content="Refresh"
                        Command="{Binding RefreshWindowsCommand}"
                        Margin="0,0,0,6" Padding="10,4" HorizontalAlignment="Left" />
                <ListView ItemsSource="{Binding Windows}"
                          SelectedItem="{Binding SelectedWindow}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding ProcessName}" />
                                <TextBlock Text="{Binding WindowTitle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11" Foreground="Gray"
                                           Text="{Binding MainWindowHandle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </GroupBox>

        <GroupBox Header="Control Tree" Grid.Column="1" Margin="4,0">
            <DockPanel>
                <Button DockPanel.Dock="Top" Content="Capture Fields"
                        Command="{Binding CaptureWindowCommand}"
                        Margin="0,0,0,6" Padding="10,4" HorizontalAlignment="Left" />
                <TreeView ItemsSource="{Binding ControlTree}"
                          VirtualizingPanel.IsVirtualizing="True">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} — {1} [{2}]">
                                        <Binding Path="ControlType" />
                                        <Binding Path="Name" />
                                        <Binding Path="AutomationId" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </GroupBox>

        <GroupBox Header="Detected Fields" Grid.Column="2" Margin="4,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Template name:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="180" VerticalContentAlignment="Center" />
                    <Button Content="Save Template" Command="{Binding SaveTemplateCommand}"
                            Margin="8,0,0,0" Padding="10,4" />
                    <Button Content="Delete" Command="{Binding DeleteTemplateCommand}"
                            Margin="8,0,0,0" Padding="10,4" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding DetectedFields}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Width="*"
                                            Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="AutomationId" Width="1.2*"
                                            Binding="{Binding AutomationId}"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="ControlType" Width="0.8*"
                                            Binding="{Binding ControlType}"
                                            IsReadOnly="True" />
                        <DataGridTemplateColumn Header="FieldType" Width="0.9*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FieldType}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.FieldTypeValues, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding FieldType, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0" ItemsSource="{Binding SavedTemplates}"
                      SelectedItem="{Binding SelectedSavedTemplate}"
                      Height="90">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button Grid.Column="1" Content="Load Templates" Command="{Binding LoadTemplatesCommand}"
                    Margin="8,0" Padding="10,4" VerticalAlignment="Top" />

            <TextBlock Grid.Column="2" Text="{Binding StatusMessage}"
                       VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="DimGray" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>
