<UserControl x:Class="FormFiller.App.Views.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1.4*" />
        </Grid.ColumnDefinitions>

        <GroupBox Header="Ventanas" Grid.Column="0" Margin="0,0,4,0">
            <DockPanel>
                <Button DockPanel.Dock="Top" Content="Actualizar"
                        Command="{Binding RefreshWindowsCommand}"
                        Style="{StaticResource OutlineButton}"
                        Margin="0,0,0,6" Padding="10,4" HorizontalAlignment="Left" />
                <ListView ItemsSource="{Binding Windows}"
                          SelectedItem="{Binding SelectedWindow}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding ProcessName}" />
                                <TextBlock Text="{Binding WindowTitle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                           Text="{Binding MainWindowHandle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </GroupBox>

        <GroupBox Header="Árbol de controles" Grid.Column="1" Margin="4,0">
            <DockPanel>
                <Button DockPanel.Dock="Top" Content="Capturar campos"
                        Command="{Binding CaptureWindowCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,0,6" Padding="10,4" HorizontalAlignment="Left" />
                <TreeView ItemsSource="{Binding ControlTree}"
                          VirtualizingPanel.IsVirtualizing="True">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} — {1} [{2}]">
                                        <Binding Path="ControlType" />
                                        <Binding Path="Name" />
                                        <Binding Path="AutomationId" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </GroupBox>

        <GroupBox Header="Campos detectados" Grid.Column="2" Margin="4,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Nombre de la plantilla:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="180" VerticalContentAlignment="Center" />
                    <Button Content="Guardar plantilla" Command="{Binding SaveTemplateCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0" Padding="10,4" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding DetectedFields}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Width="*"
                                            Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="ID de automatización" Width="1.2*"
                                            Binding="{Binding AutomationId}"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="Tipo de control" Width="0.8*"
                                            Binding="{Binding ControlType}"
                                            IsReadOnly="True" />
                        <DataGridTemplateColumn Header="Tipo de campo" Width="0.9*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FieldType, Converter={StaticResource EnumToSpanishConverter}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.FieldTypeValues, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding FieldType, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumToSpanishConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0" ItemsSource="{Binding SavedTemplates}"
                      SelectedItem="{Binding SelectedSavedTemplate}"
                      Height="90">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Top">
                <Button Content="Cargar plantillas" Command="{Binding LoadTemplatesCommand}"
                        Style="{StaticResource OutlineButton}" Padding="10,4" />
                <Button Content="Eliminar plantilla" Command="{Binding DeleteTemplateCommand}"
                        Style="{StaticResource DangerButton}" Margin="0,6,0,0" Padding="10,4" />
            </StackPanel>

            <TextBlock Grid.Column="2" Text="{Binding StatusMessage}"
                       VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>
